generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Payments {
  CASH
  CARD
  GIBRID
}

enum Booking_status {
  PENDING
  CONFIRMED
  CANCELLED
}

enum Pay_method {
  CASH
  CARD
}

enum Tranzaktion_status {
  PENDING
  PAID
  FAILED
}

model Owners {
  id         Int          @id @default(autoincrement())
  full_name  String
  username   String
  chatID     String       @unique
  phone      String
  email      String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  ownerCards Owner_card[]
  stadions   Stadion[]
}

model Users {
  id           Int           @id @default(autoincrement())
  username     String
  phone        String
  full_name    String
  chatId       String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tranzaktions Tranzaktion[]
  bookings     Booking[]
}

model Stadion {
  id              Int               @id @default(autoincrement())
  name            String
  lockation       String
  image           String
  price           Int
  region_id       Int
  region_item_id  Int
  owner_id        Int
  working_status  Boolean           @default(true)
  length          Int
  width           Int
  payments_type   Payments          @default(GIBRID)
  is_premium      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  stadionChedules Stadion_chedule[]
  bookings        Booking[]

  region       Region      @relation(fields: [region_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  region_items Region_item @relation(fields: [region_item_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner        Owners      @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Stadion_chedule {
  id          Int     @id @default(autoincrement())
  stadion_id  Int
  day_of_week Int
  start_time  String
  end_time    String
  stadion     Stadion @relation(fields: [stadion_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Region {
  id          Int           @id @default(autoincrement())
  name        String
  regionItems Region_item[]
  stadions    Stadion[]
}

model Region_item {
  id        Int       @id @default(autoincrement())
  name      String
  region_id Int
  region    Region    @relation(fields: [region_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stadions  Stadion[]
}

model Owner_card {
  id           Int           @id @default(autoincrement())
  owner_id     Int
  card_numbar  String
  is_active    Boolean
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        Owners        @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tranzaktions Tranzaktion[]
}

model Booking {
  id             Int            @id @default(autoincrement())
  user_id        Int
  stadion_id     Int
  date           DateTime
  start_time     DateTime       @db.Time()
  end_time       DateTime       @db.Time()
  total_price    Int
  status         Booking_status @default(PENDING)
  payment_method Pay_method
  createdAt      DateTime       @default(now())
  tranzaktions   Tranzaktion[]
  user           Users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stadion        Stadion        @relation(fields: [stadion_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Tranzaktion {
  id                     Int                @id @default(autoincrement())
  user_id                Int
  booking_id             Int
  systeam_fee            Int
  owner_amount           Int
  provider               String
  provider_transactionId String
  status                 Tranzaktion_status @default(PENDING)
  click_fee              Int
  owner_cred_id          Int
  amount_received        Int
  createdAt              DateTime           @default(now())
  user                   Users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  booking                Booking            @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  owner_cards Owner_card @relation(fields: [owner_cred_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
