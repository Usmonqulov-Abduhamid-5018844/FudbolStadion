generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owners {
  id                   Int                  @id @default(autoincrement())
  full_name            String
  username             String?
  chatID               String               @unique
  phone                String
  status               Admin_S              @default(PENDING)
  email                String               @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  notificationSettings Json
  ownerCard            Owner_card?
  stadions             Stadion[]
  notification         Notification[]
  subscriptions        Subscription[]
  premiumTransactions  PremiumTransaction[]
  advertisements       Advertisement[]
}

model Users {
  id                  Int                  @id @default(autoincrement())
  username            String?
  phone               String
  full_name           String
  chatID              String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookings            Booking[]
  myFavoriteStadiums  MyFavoriteStadium[]
  tranzaktions        Tranzaktion[]
  advertisementClicks AdvertisementClick[]

  @@index([phone])
}

model Stadion {
  id                      Int                        @id @default(autoincrement())
  name                    String
  latitude                Float
  longitude               Float
  image                   String
  price                   Int
  region_id               Int
  max_count               Int
  region_item_id          Int
  mini                    Boolean                    @default(false)
  stadion_mini            Boolean                    @default(false)
  owner_id                Int
  admin_status            AdminStatus                @default(PENDING)
  working_status          Boolean                    @default(false)
  length                  Int
  width                   Int
  payments_type           Payments                   @default(GIBRID)
  parent_id               Int?
  parent                  Stadion?                   @relation("StadionToChild", fields: [parent_id], references: [id])
  children                Stadion[]                  @relation("StadionToChild")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  bookings                Booking[]
  myFavoriteStadiums      MyFavoriteStadium[]
  owner                   Owners                     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  region                  Region                     @relation(fields: [region_id], references: [id], onDelete: Cascade)
  region_items            Region_item                @relation(fields: [region_item_id], references: [id], onDelete: Cascade)
  stadionChedules         Stadion_chedule[]
  stadionOffDays          stadion_off_days[]
  stadionSpecialSchedules stadion_special_schedule[]
  advertisements          Advertisement[]

  @@index([owner_id])
}

model Stadion_chedule {
  id          Int     @id @default(autoincrement())
  stadion_id  Int
  day_of_week Int
  start_time  String
  end_time    String
  stadion     Stadion @relation(fields: [stadion_id], references: [id], onDelete: Cascade)
}

model stadion_off_days {
  id         Int      @id @default(autoincrement())
  stadion_id Int
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  desc       String?
  stadion    Stadion  @relation(fields: [stadion_id], references: [id], onDelete: Cascade)
}

model stadion_special_schedule {
  id         Int      @id @default(autoincrement())
  stadion_id Int
  date       DateTime @db.Date
  start_time String
  end_time   String
  stadion    Stadion  @relation(fields: [stadion_id], references: [id], onDelete: Cascade)
}

model Region {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  regionItems Region_item[]
  stadions    Stadion[]
}

model Region_item {
  id        Int       @id @default(autoincrement())
  name      String
  region_id Int
  region    Region    @relation(fields: [region_id], references: [id], onDelete: Cascade)
  stadions  Stadion[]

  @@unique([name, region_id])
}

model Owner_card {
  id           Int           @id @default(autoincrement())
  owner_id     Int           @unique
  createdAt    DateTime      @default(now())
  cardMask     String
  cardToken    String
  cardType     String
  expireMonth  String
  expireYear   String
  isActive     Boolean
  provider     String
  owner        Owners        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  tranzaktions Tranzaktion[]
}

model Booking {
  id               Int            @id @default(autoincrement())
  user_id          Int?
  stadion_id       Int
  customer_name    String?
  customer_phone   String?
  date             DateTime       @db.Date
  start_time       String
  end_time         String
  total_price      Decimal
  startAt          DateTime
  endAt            DateTime
  check_in         Boolean        @default(false)
  status           Booking_status @default(PENDING)
  payment_method   Pay_method
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  expires_at       DateTime?
  status_pay_later Boolean        @default(false)
  stadion          Stadion        @relation(fields: [stadion_id], references: [id], onDelete: Cascade)
  user             Users?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tranzaktions     Tranzaktion?
  notifications    Notification[]

  @@index([status, startAt, status_pay_later])
  @@index([status, endAt, check_in])
  @@index([stadion_id, date])
}

model Tranzaktion {
  id                     Int                @id @default(autoincrement())
  user_id                Int
  booking_id             Int                @unique
  systeam_fee            Int
  owner_amount           Decimal
  provider               String
  provider_transactionId String?
  status                 Tranzaktion_status @default(PENDING)
  amount_received        Decimal
  createdAt              DateTime           @default(now())
  owner_card_id          Int
  booking                Booking            @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  owner_cards            Owner_card         @relation(fields: [owner_card_id], references: [id])
  user                   Users              @relation(fields: [user_id], references: [id])
}

model Subscription {
  id Int @id @default(autoincrement())

  ownerId Int
  owner   Owners @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  plan PremiumPlan

  startDate DateTime

  endDate DateTime

  reason PremiumReason @default(PURCHASE)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  premiumTransactions PremiumTransaction[]

  @@index([ownerId, isActive])
}

model PremiumTransaction {
  id Int @id @default(autoincrement())

  owner_id Int
  owner    Owners @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  subscription_id Int?
  subscription    Subscription? @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  duration Int

  plan PremiumPlan

  amount Int

  reason PremiumReason @default(PURCHASE)

  provider String

  provider_transactionId String?

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([owner_id])
  @@index([subscription_id])
}

model sesion {
  id              Int     @id @default(autoincrement())
  lang            String?
  step            String?
  chat_id         String  @unique
  stadionId       Int?
  advertisementId Int?
}

model MyFavoriteStadium {
  id         Int      @id @default(autoincrement())
  chat_id    String
  stadion_id Int
  createdAt  DateTime @default(now())
  user       Users    @relation(fields: [chat_id], references: [chatID], onDelete: Cascade)
  stadion    Stadion  @relation(fields: [stadion_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, stadion_id])
}

model Notification {
  id               Int              @id @default(autoincrement())
  ownerId          Int
  type             NotificationType
  isRead           Boolean          @default(false)
  relatedBookingId Int?
  data             Json?
  sentAt           DateTime?
  createdAt        DateTime         @default(now())

  translations Json

  owner   Owners   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([ownerId, isRead, sentAt])
  @@index([createdAt])
}

model Advertisement {
  id Int @id @default(autoincrement())

  ownerId Int
  owner   Owners @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  stadionId Int
  stadion   Stadion @relation(fields: [stadionId], references: [id], onDelete: Cascade)

  title String @db.VarChar(120)

  description String @db.Text

  image String?

  channelSentCount Int @default(0) // Kanalga yuborilganlar soni

  botViewCount Int @default(0) // Botda ko'rsatilganlar soni

  clickCount Int @default(0) // Reklamani bosganlar soni

  lastSentAt DateTime?

  expiresAt DateTime
  status    AdvertisementStatus @default(PENDING)

  clicks    AdvertisementClick[]
  createdAt DateTime             @default(now())

  @@index([ownerId])
  @@index([stadionId])
  @@index([status])
}

model AdvertisementClick {
  id Int @id @default(autoincrement())

  advertisementId Int
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  source AdvertisementClickSource
  userId Int
  user   Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  clickedAt DateTime @default(now())

  @@unique([advertisementId, userId])
  @@index([advertisementId])
  @@index([userId])
}

enum AdvertisementClickSource {
  BOT
  CHANNEL
}

enum AdvertisementStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum Payments {
  CASH
  CARD
  GIBRID
}

enum Booking_status {
  PENDING
  CONFIRMED
  PAID
  COMPLETED
  CANCELED
  NOSHOW
  REFUNDED
}

enum Pay_method {
  CASH
  CARD
}

enum Tranzaktion_status {
  PENDING
  PAID
  FAILED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PremiumPlan {
  WEEK_1
  MONTH_1
  MONTH_3
  MONTH_6
  YEAR_1
}

enum NotificationType {
  DAILY_REPORT
  WEEKLY_STATS
  CANCELLED_BOOKINGS
  PAYMENT_RECEIVED
  BOOKING_CONFIRMED
  PREMIUM_EXPIRY
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Admin_S {
  PENDING
  ACTIVE
  BLOCKED
}

enum PremiumReason {
  TRIAL
  PURCHASE
  GIFT
  COMPENSATION
}
